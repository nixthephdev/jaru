Options -Indexes
DirectoryIndex index.php

# Never serve the database, includes, or dotfiles.
RedirectMatch 404 ^/?(.*/)?(data|inc)(/|$)
<FilesMatch "(^\.|\.(sqlite|sqlite3|db|md|log|zip)$)">
  Require all denied
</FilesMatch>

# Force HTTPS on the live domain only (local testing is untouched).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^(www\.)?jarucafe\.shop$ [NC]
  RewriteRule ^ https://jarucafe.shop%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.jarucafe\.shop$ [NC]
  RewriteRule ^ https://jarucafe.shop%{REQUEST_URI} [R=301,L]
</IfModule>

# PHP pages send their own security headers (inc/bootstrap.php); these cover static files.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|png|webp|svg)$">
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>
