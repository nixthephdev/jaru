# Photos only: never run scripts from here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
